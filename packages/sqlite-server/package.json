{
  "name": "@sp/sqlite-server",
  "version": "0.1.0",
  "private": true,
  "description": "Self-hosted Super Productivity server: SuperSync-compatible sync API backed by SQLite (node:sqlite)",
  "main": "dist/src/index.js",
  "bin": {
    "sp-sqlite-server": "dist/src/cli.js"
  },
  "engines": {
    "node": ">=22.13.0"
  },
  "scripts": {
    "build": "tsc -p tsconfig.json && node scripts/build-engine.js",
    "build:server": "tsc -p tsconfig.json",
    "build:engine": "node scripts/build-engine.js",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "start": "node dist/src/index.js",
    "cli": "node dist/src/cli.js",
    "test": "vitest run"
  },
  "dependencies": {
    "@sp/shared-schema": "*",
    "@sp/sync-core": "*"
  },
  "devDependencies": {
    "@types/node": "^24.19.0",
    "typescript": "^5.0.0",
    "vitest": "^5.0.3",
    "esbuild": "^0.28.2"
  }
}
